{
    "version": 3,
    "configurePresets": [
        {
            "name": "windows-debug",
            "displayName": "Windows Debug (MinGW)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/windows-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_PREFIX_PATH": "C:/Qt/6.x.x/mingw_64",
                "OPENSSL_ROOT_DIR": "C:/msys64/mingw64"
            }
        },
        {
            "name": "windows-release",
            "displayName": "Windows Release (MinGW)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/windows-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_PREFIX_PATH": "C:/Qt/6.x.x/mingw_64",
                "OPENSSL_ROOT_DIR": "C:/msys64/mingw64"
            }
        },
        {
            "name": "linux-debug",
            "displayName": "Linux Debug (GCC)",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build/linux-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_COLOR_DIAGNOSTICS": "ON",
                "CMAKE_CXX_COMPILER": "/usr/bin/g++",
                "OPENSSL_CRYPTO_LIBRARY": "/usr/lib64/libcrypto.so",
                "OPENSSL_SSL_LIBRARY": "/usr/lib64/libssl.so"
            }
        },
        {
            "name": "linux-release",
            "displayName": "Linux Release (GCC)",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build/linux-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CXX_COMPILER": "/usr/bin/g++",
                "OPENSSL_CRYPTO_LIBRARY": "/usr/lib64/libcrypto.so",
                "OPENSSL_SSL_LIBRARY": "/usr/lib64/libssl.so"
            }
        }
    ]
}
